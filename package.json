{
  "name": "nasa-earth-system-trend-detective-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorrepo oficial de la plataforma NASA Earth System Trend Detective - NASA Space Apps Challenge 2026",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "node scripts/run-local.js",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "dotnet run --project backend/src/NasaTrendDetective.Api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "doctor": "npx -y react-doctor@latest frontend --verbose"
  },
  "keywords": [
    "nasa",
    "space-apps-challenge-2026",
    "earth-science",
    "climate-trends",
    "mann-kendall",
    "sens-slope",
    "monorepo",
    "dotnet10",
    "react19",
    "duckdb"
  ],
  "author": "Brayan Stid Cortés Lombana & Team",
  "license": "MIT"
}
