# ==============================================================================
# Git Ignore Configuration - NASA Earth System Trend Detective
# ==============================================================================

# Environment and sensitive credentials
.env
.env.*
!.env.example
*.local
*.key
*.token
*.pem

# Editor and AI tooling metadata exclusions (Strict)
.agents/
.gemini/
.claude/
.cursor/
.windsurf/
.copilot/
*.prompt
*.prompt.md

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs and temporary files
dist/
build/
bin/
obj/
*.log
*.tmp
__pycache__/
*.py[cod]

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Database local runtime files
*.duckdb.tmp
*.duckdb.wal

# Testing coverage reports
coverage/
TestResults/

# Local visual validation artifacts and downloaded source tooling
output/
.vercel
.env*
