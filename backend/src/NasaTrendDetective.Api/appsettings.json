{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "HeavyAnalysisPermitLimit": 60,
    "WindowSeconds": 60,
    "RequestTimeoutSeconds": 15
  },
  "DuckDb": {
    "DatabasePath": "nasa_earth_trends.duckdb"
  },
  "NasaEarthData": {
    "CmrBaseUrl": "https://cmr.earthdata.nasa.gov/",
    "CacheDirectory": "data/nasa/raw",
    "MaxRetryAttempts": 4,
    "RetryBaseDelay": "00:00:02",
    "AttemptTimeout": "00:01:00"
  },
  "GridNormalization": {
    "OutputDirectory": "data/nasa/normalized"
  },
  "ParquetImport": {
    "SourceGlob": "data/nasa/normalized/*.parquet"
  }
}
