# ==============================================================================
# ClickUp API Integration Configuration
# ==============================================================================
# Obtén tu token en ClickUp: Profile Settings > Apps > Generate / Copy API Token
CLICKUP_API_TOKEN=pk_your_clickup_personal_api_token_here

# ID del Workspace/Equipo en ClickUp. Puedes descubrirlo ejecutando: npm run teams
CLICKUP_TEAM_ID=your_team_id_here

# (Opcional) Nombre del Espacio que se creará o vinculará en ClickUp
CLICKUP_SPACE_NAME=NASA Space Apps 2026

# (Opcional) Nombre de la Carpeta contenedora de las listas/sprints
CLICKUP_FOLDER_NAME=NASA Earth System Trend Detective

# (Opcional) Mapeo de IDs de usuario de ClickUp para los 5 participantes
# Si se dejan en blanco o 0, el script creará las tareas asignando etiquetas/tags de rol
PARTICIPANT_1_CLICKUP_ID=
PARTICIPANT_2_CLICKUP_ID=
PARTICIPANT_3_CLICKUP_ID=
PARTICIPANT_4_CLICKUP_ID=
PARTICIPANT_5_CLICKUP_ID=
