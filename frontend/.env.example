# Copia este archivo como .env.local (no se versiona) y rellena lo que necesites.

# Fuente de datos por variable: auto (predeterminado) = API para las variables con dataset real
# cargado y demo rotulada para el resto; demo o api fuerzan una fuente.
# VITE_OBSERVATION_DATA_SOURCE=auto
# VITE_HEX_DATA_SOURCE=auto

# Alta resolución al acercar (coches, barcos, casas) con Esri World Imagery. Sin clave se usa
# Landsat de la NASA. La clave queda dentro del JavaScript público: restríngela por dominio
# (referrer) en el panel de ArcGIS. Precio verificado: 2M mosaicos/mes gratis, luego 0,15 USD/1000.
# Para usar Esri World Imagery, define VITE_ESRI_API_KEY en .env.local (o en Vercel / GitHub Secrets).
# VITE_ESRI_API_KEY=
