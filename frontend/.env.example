# Copy this file as .env.local (not versioned) and fill in whatever you need.

# Data source per variable: auto (default) = API for variables with a real dataset
# loaded and labeled demo for the rest; demo or api force one source.
# VITE_OBSERVATION_DATA_SOURCE=auto
# VITE_HEX_DATA_SOURCE=auto

# High resolution when zooming in (cars, boats, houses) with Esri World Imagery. Without a key,
# NASA Landsat is used. The key stays in public JavaScript: restrict it by domain
# (referrer) in the ArcGIS dashboard. Verified pricing: 2M tiles/month free, then $0.15 USD/1000.
# To use Esri World Imagery, set VITE_ESRI_API_KEY in .env.local (or in Vercel / GitHub Secrets).
# VITE_ESRI_API_KEY=
